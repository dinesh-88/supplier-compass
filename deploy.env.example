# Copy to deploy.env (git-ignored) and fill in. Read by scripts/deploy_nebius.sh.

# ---- Nebius ------------------------------------------------------------------
# Region of your project, e.g. eu-north1. Images go to cr.$REGION_ID.nebius.cloud.
REGION_ID=eu-north1
# Optional: project ID. Defaults to the parent-id of the current Nebius CLI profile.
PROJECT_ID=
# Container Registry name; created if it does not exist.
REGISTRY_NAME=supplier-compass
# Endpoint name; the script creates it, or stops and asks before replacing an existing one.
ENDPOINT_NAME=supplier-compass
PLATFORM=cpu-d3
PRESET=4vcpu-16gb

# ---- App (passed to the container with --env) -----------------------------------
# Jury logins: comma-separated name:password pairs. Use long random passwords.
APP_USERS=jury:change-me
# Required. Signs session cookies. Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1/
LLM_API_KEY=
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
# Optional faster model for the research agent's planning and triage.
LLM_FAST_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
TAVILY_API_KEY=
# Wiped on restart: the bundled sample always loads, uploads may be lost.
DATA_DIR=/tmp/data
