# Jury logins: comma-separated name:password pairs. Passwords are hashed at startup.
APP_USERS=jury:change-me
# Signs the session cookie. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Set to 1 when the app is served over HTTPS.
COOKIE_SECURE=0

# LLM: any OpenAI-compatible endpoint. Default: Nemotron on Nebius Token Factory.
LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1/
LLM_API_KEY=
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
# Optional faster model for planning/triage in the research agent.
LLM_FAST_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# Extra completion tokens for models that reason before answering (Nemotron 3).
LLM_REASONING_TOKENS=3000

# Web search for the research agent.
TAVILY_API_KEY=
